// openclaw.json candidate: ACP spike — Claude Code via ACP core
// Target sections:
//   - acp (new top-level block)
//   - agents.list[] (add claude-engineer agent)
// Date: 2026-03-25 (updated for 2026.3.22+ where ACP is in core)
// Prerequisite: docs/planning/phase4-acp-claude-code-research.md (Option A)
//
// *** IMPORTANT: This candidate has TWO VARIANTS ***
//   Variant A: For 2026.3.13 (current live) — uses acpx plugin
//   Variant B: For 2026.3.22+ (after upgrade) — ACP in core, NO plugin
// Upgrade evaluation: docs/planning/openclaw-upgrade-3.23-evaluation.md
//
// This is a DELTA candidate — only the new/changed sections are shown.
// Apply by merging into the existing live openclaw.json.
// ESCALATION: This changes /etc/openclaw/openclaw.json. Full plan in
//   candidates/openclaw.acp-spike.delta.md

{
  // ═══════════════════════════════════════════════════════════════
  // NEW: ACP top-level block
  // ═══════════════════════════════════════════════════════════════
  acp: {
    enabled: true,
    dispatch: {
      enabled: true,
    },

    // --- Variant A (2026.3.13): uncomment next line ---
    // backend: "acpx",

    // --- Variant B (2026.3.22+): no backend field needed (ACP in core) ---

    defaultAgent: "claude",
    allowedAgents: ["claude"],

    // Conservative: 2 concurrent ACP sessions max for spike.
    maxConcurrentSessions: 2,

    stream: {
      coalesceIdleMs: 300,
      maxChunkChars: 1200,
    },

    runtime: {
      // 60-minute session lifetime for spike testing.
      ttlMinutes: 60,

      // ACP runs as openclaw user on host. approve-all required
      // for non-interactive operation.
      permissionMode: "approve-all",
    },
  },

  // ═══════════════════════════════════════════════════════════════
  // PLUGINS: Variant-dependent
  // ═══════════════════════════════════════════════════════════════

  // --- Variant A (2026.3.13 ONLY): acpx plugin required ---
  // plugins: {
  //   allow: ["feishu", "acpx"],
  //   entries: {
  //     acpx: {
  //       enabled: true,
  //       config: {
  //         permissionMode: "approve-all",
  //         nonInteractivePermissions: "fail",
  //         expectedVersion: "any",
  //       },
  //     },
  //   },
  // },

  // --- Variant B (2026.3.22+): NO acpx in plugins ---
  // DO NOT add plugins.entries.acpx — it triggers warning #52910
  // ACP config goes in the acp{} block above.
  plugins: {
    // hook cleanup: remove tool-audit-plugin (test residual)
    allow: ["feishu"],
  },

  // ═══════════════════════════════════════════════════════════════
  // NEW: claude-engineer agent (ACP runtime)
  // ═══════════════════════════════════════════════════════════════
  agents: {
    list: [
      // ... existing entries preserved (task-runner, etc.) ...
      {
        id: "claude-engineer",
        name: "Claude Engineer (ACP)",

        model: {
          primary: "motchat-claude-4-6/claude-opus-4-6",
        },

        tools: {
          profile: "coding",
        },

        workspace: "workspace-claude-engineer",

        runtime: {
          type: "acp",
          acp: {
            agent: "claude",
            // --- Variant A (2026.3.13): uncomment ---
            // backend: "acpx",
            mode: "persistent",
            cwd: "/var/lib/openclaw/task-workspaces",
          },
        },
      },
    ],
  },

  // ═══════════════════════════════════════════════════════════════
  // ENVIRONMENT VARIABLES (NOT in openclaw.json — external config)
  // ═══════════════════════════════════════════════════════════════
  // Required for ACP Claude Code child processes:
  //
  // Option 1 (recommended): /etc/openclaw/openclaw.env
  //   ANTHROPIC_BASE_URL=https://new.motchat.com
  //   ANTHROPIC_API_KEY=<motchat-api-key>
  //
  // Option 2: systemd override
  //   /etc/systemd/system/openclaw-gateway.service.d/acp-env.conf
  //   [Service]
  //   Environment=ANTHROPIC_BASE_URL=https://new.motchat.com
  //   Environment=ANTHROPIC_API_KEY=<motchat-api-key>
}
