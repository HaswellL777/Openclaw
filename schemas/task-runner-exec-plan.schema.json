{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskRunnerExecPlan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "image",
    "workspace",
    "inputs",
    "outputs",
    "environment",
    "tool_contract",
    "invocation",
    "network",
    "privilege",
    "boundary_carry_forward"
  ],
  "properties": {
    "schema_version": {
      "const": "openclaw.task-runner.exec-plan.v1alpha1"
    },
    "plan_id": {
      "$ref": "#/$defs/id_string"
    },
    "task_id": {
      "$ref": "#/$defs/id_string"
    },
    "image": {
      "type": "object",
      "required": [
        "reference",
        "pull_policy",
        "run_as_user",
        "workdir",
        "entrypoint"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/non_empty_string"
        },
        "pull_policy": {
          "type": "string",
          "enum": [
            "never",
            "if_not_present"
          ]
        },
        "run_as_user": {
          "const": "runner"
        },
        "workdir": {
          "const": "/workspace/repo"
        },
        "entrypoint": {
          "const": "/usr/local/bin/task-runner-entrypoint"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "layout_mode",
        "layout_artifact",
        "root_path",
        "repo_path",
        "inputs_path",
        "outputs_path",
        "artifact_export_path"
      ],
      "properties": {
        "layout_mode": {
          "type": "string",
          "enum": [
            "readonly",
            "dev"
          ]
        },
        "layout_artifact": {
          "$ref": "#/$defs/relative_path"
        },
        "root_path": {
          "const": "/workspace"
        },
        "repo_path": {
          "const": "/workspace/repo"
        },
        "inputs_path": {
          "const": "/workspace/inputs"
        },
        "outputs_path": {
          "const": "/workspace/outputs"
        },
        "artifact_export_path": {
          "const": "/workspace/outputs/export"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "required": [
        "required_inputs"
      ],
      "properties": {
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/container_workspace_path"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": [
        "required_artifacts",
        "artifact_export_path",
        "preserve_failed_run_logs"
      ],
      "properties": {
        "required_artifacts": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/container_outputs_path"
          },
          "uniqueItems": true
        },
        "artifact_export_path": {
          "const": "/workspace/outputs/export"
        },
        "preserve_failed_run_logs": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "allowed",
        "required",
        "forbidden"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/env_name"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "tool_contract": {
      "type": "object",
      "required": [
        "agent_tools",
        "container_binaries"
      ],
      "properties": {
        "agent_tools": {
          "type": "object",
          "required": [
            "allow",
            "deny"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              },
              "uniqueItems": true
            },
            "deny": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "container_binaries": {
          "type": "object",
          "required": [
            "expected_available",
            "expected_unavailable"
          ],
          "properties": {
            "expected_available": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              },
              "uniqueItems": true
            },
            "expected_unavailable": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/non_empty_string"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": [
        "runner",
        "mode",
        "bootstrap_path",
        "prompt_source"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "enum": [
            "codex",
            "claudecode"
          ]
        },
        "mode": {
          "const": "non_interactive"
        },
        "bootstrap_path": {
          "type": "string",
          "enum": [
            "/usr/local/bin/bootstrap-codex",
            "/usr/local/bin/bootstrap-claudecode"
          ]
        },
        "prompt_source": {
          "type": "string",
          "enum": [
            "file",
            "stdin"
          ]
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": [
        "mode",
        "allow_host_network",
        "allowed_endpoints"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "restricted-egress"
          ]
        },
        "allow_host_network": {
          "const": false
        },
        "allowed_endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "privilege": {
      "type": "object",
      "required": [
        "run_as_non_root",
        "user",
        "allow_privilege_escalation",
        "read_only_rootfs",
        "no_new_privileges"
      ],
      "properties": {
        "run_as_non_root": {
          "const": true
        },
        "user": {
          "const": "runner"
        },
        "allow_privilege_escalation": {
          "const": false
        },
        "read_only_rootfs": {
          "const": true
        },
        "no_new_privileges": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "boundary_carry_forward": {
      "type": "object",
      "required": [
        "repo_side_only",
        "live_side_publish_performed",
        "broker_dispatch_performed",
        "real_docker_run_required",
        "openclaw_runtime_modified"
      ],
      "properties": {
        "repo_side_only": {
          "const": true
        },
        "live_side_publish_performed": {
          "const": false
        },
        "broker_dispatch_performed": {
          "const": false
        },
        "real_docker_run_required": {
          "const": false
        },
        "openclaw_runtime_modified": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "id_string": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\n]+$"
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "container_workspace_path": {
      "type": "string",
      "pattern": "^/workspace/(inputs|repo|outputs)(?:/[^\\n]+)?$"
    },
    "container_outputs_path": {
      "type": "string",
      "pattern": "^/workspace/outputs(?:/[^\\n]+)?$"
    }
  }
}
