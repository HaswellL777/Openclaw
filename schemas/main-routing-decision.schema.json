{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainRoutingDecision",
  "type": "object",
  "required": [
    "schema_version",
    "routing_decision_id",
    "routing_mode",
    "intake_id",
    "task_id",
    "run_id",
    "source_request_id",
    "decision",
    "submission_target",
    "intake_status",
    "dispatch_scope",
    "dispatch_status",
    "requires_operator_approval",
    "source_artifacts",
    "summary_context",
    "validation_status",
    "broker_request_count",
    "refusal_reasons",
    "forbidden_actions",
    "boundary_carry_forward",
    "evidence_refs",
    "reasoning"
  ],
  "properties": {
    "schema_version": {
      "const": "openclaw.main.routing-decision.v1alpha1"
    },
    "routing_decision_id": {
      "$ref": "#/$defs/id_string"
    },
    "routing_mode": {
      "const": "repo_side_dry_run"
    },
    "intake_id": {
      "$ref": "#/$defs/id_string"
    },
    "task_id": {
      "$ref": "#/$defs/id_string"
    },
    "run_id": {
      "$ref": "#/$defs/id_string"
    },
    "source_request_id": {
      "$ref": "#/$defs/id_string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "LOCAL_REFUSE",
        "REQUIRES_OPERATOR_APPROVAL",
        "BROKER_SUBMISSION_CANDIDATE"
      ]
    },
    "submission_target": {
      "type": "string",
      "enum": [
        "none",
        "operator_approval_envelope",
        "broker_submission_envelope"
      ]
    },
    "intake_status": {
      "type": "string",
      "enum": ["accepted", "refused"]
    },
    "dispatch_scope": {
      "type": "string",
      "enum": ["readonly", "host_affecting", "unclassified"]
    },
    "dispatch_status": {
      "type": "string",
      "enum": ["broker_ready", "operator_approval_required", "refused"]
    },
    "requires_operator_approval": {
      "type": "boolean"
    },
    "source_artifacts": {
      "type": "object",
      "required": ["normalized_request_path", "intake_report_path"],
      "properties": {
        "normalized_request_path": {
          "$ref": "#/$defs/relative_path"
        },
        "intake_report_path": {
          "$ref": "#/$defs/relative_path"
        }
      },
      "additionalProperties": false
    },
    "summary_context": {
      "type": "object",
      "required": ["goal", "outcome", "request_title", "request_scope"],
      "properties": {
        "goal": {
          "$ref": "#/$defs/non_empty_string"
        },
        "outcome": {
          "$ref": "#/$defs/non_empty_string"
        },
        "request_title": {
          "$ref": "#/$defs/non_empty_string"
        },
        "request_scope": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "validation_status": {
      "type": "object",
      "required": ["normalized_request", "intake_report", "cross_document"],
      "properties": {
        "normalized_request": {
          "$ref": "#/$defs/validation_result"
        },
        "intake_report": {
          "$ref": "#/$defs/validation_result"
        },
        "cross_document": {
          "$ref": "#/$defs/validation_result"
        }
      },
      "additionalProperties": false
    },
    "broker_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "refusal_reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "forbidden_actions": {
      "$ref": "#/$defs/forbidden_actions"
    },
    "boundary_carry_forward": {
      "$ref": "#/$defs/boundary_carry_forward"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "reasoning": {
      "$ref": "#/$defs/non_empty_string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "LOCAL_REFUSE"
          }
        }
      },
      "then": {
        "properties": {
          "submission_target": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REQUIRES_OPERATOR_APPROVAL"
          }
        }
      },
      "then": {
        "properties": {
          "submission_target": {
            "const": "operator_approval_envelope"
          },
          "requires_operator_approval": {
            "const": true
          },
          "dispatch_status": {
            "const": "operator_approval_required"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "BROKER_SUBMISSION_CANDIDATE"
          }
        }
      },
      "then": {
        "properties": {
          "submission_target": {
            "const": "broker_submission_envelope"
          },
          "intake_status": {
            "const": "accepted"
          },
          "dispatch_status": {
            "const": "broker_ready"
          },
          "requires_operator_approval": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "id_string": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\n]+$"
    },
    "validation_result": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "direct_host_shell",
          "direct_openclaw_config_edit",
          "direct_systemd_control",
          "direct_docker_control",
          "direct_snapshot_manipulation",
          "direct_vault_manipulation",
          "direct_secret_handling",
          "unstructured_operator_commands",
          "user_level_gateway_start"
        ]
      }
    },
    "boundary_carry_forward": {
      "type": "object",
      "required": [
        "repo_side_only",
        "live_side_publish_performed",
        "broker_dispatch_performed",
        "openclaw_runtime_modified",
        "operator_command_blocks_present"
      ],
      "properties": {
        "repo_side_only": {
          "const": true
        },
        "live_side_publish_performed": {
          "const": false
        },
        "broker_dispatch_performed": {
          "const": false
        },
        "openclaw_runtime_modified": {
          "const": false
        },
        "operator_command_blocks_present": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": ["id", "kind", "path", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "design_doc",
            "sop_doc",
            "boundary_doc",
            "repo_file",
            "output_file",
            "schema",
            "fixture",
            "validator_log"
          ]
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "description": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
