{
  "schema_version": "openclaw.task-runner.workspace-layout.v1alpha1",
  "layout_id": "tr-layout:task-intake-readonly",
  "task_id": "task-intake-readonly",
  "workspace_mode": "readonly",
  "container_root": "/workspace",
  "control_surface": {
    "policy_files": [
      "AGENTS.md",
      "TOOLS.md",
      "control/runner-policy.md",
      "control/artifact-contract.md"
    ]
  },
  "mounts": [
    {
      "name": "repo",
      "source_relpath": "tasks/task-intake-readonly/repo",
      "container_path": "/workspace/repo",
      "access": "ro",
      "required": true
    },
    {
      "name": "inputs",
      "source_relpath": "tasks/task-intake-readonly/inputs",
      "container_path": "/workspace/inputs",
      "access": "ro",
      "required": true
    },
    {
      "name": "outputs",
      "source_relpath": "tasks/task-intake-readonly/outputs",
      "container_path": "/workspace/outputs",
      "access": "rw",
      "required": true
    }
  ],
  "writable_paths": [
    "/workspace/outputs",
    "/workspace/outputs/export",
    "/tmp",
    "/var/tmp",
    "/run"
  ],
  "tmpfs_paths": [
    "/tmp",
    "/var/tmp",
    "/run"
  ],
  "artifact_export": {
    "container_path": "/workspace/outputs/export",
    "source_relpath": "tasks/task-intake-readonly/outputs/export",
    "access": "rw",
    "required": true
  },
  "retained_artifacts": [
    "summary.md",
    "summary.json",
    "diff.patch",
    "host-change-request.json"
  ],
  "boundary_carry_forward": {
    "repo_side_only": true,
    "live_side_publish_performed": false,
    "broker_dispatch_performed": false,
    "real_docker_run_required": false,
    "openclaw_runtime_modified": false
  }
}
